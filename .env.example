MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=makersmap
X_BEARER_TOKEN=your_x_bearer_token
# Preferred data provider for the importer (twitterapi.io dashboard -> API key). When set, X_BEARER_TOKEN is not used for search.
TWITTERAPI_IO_KEY=
# Optional. When set, match intros on profiles are written by Claude instead of the rules engine.
ANTHROPIC_API_KEY=sk-ant-...
# Or use OpenRouter (any model). Used when ANTHROPIC_API_KEY is empty. Default model: openai/gpt-4o-mini
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=
# Optional. Weekly "people looked at your pin" emails go out through Resend when set.
RESEND_API_KEY=
EMAIL_FROM=MakersMap <hello@makersmap.net>
# Admin console at /admin and the import/outreach APIs. Any long random string.
ADMIN_SECRET=change-me
# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me-too
# X OAuth 2.0 app (developer.x.com) with the callback set to <SITE_URL>/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Set to true only after turning on "Request email from users" in the X app (needs privacy + terms URLs). Otherwise X refuses sign-in.
X_REQUEST_EMAIL=
# Public origin, used for OAuth callbacks and claim links. Defaults to http://localhost:5173 in dev.
SITE_URL=http://localhost:5173
# Optional, cookie-free analytics. Set to your domain (e.g. makersmap.net) to load Plausible.
PLAUSIBLE_DOMAIN=
# Optional. DataFast analytics (datafa.st): the website ID from your dashboard, e.g. dfid_...
DATAFAST_WEBSITE_ID=
# Optional. PostHog analytics: the project API key (PostHog > Settings > Project, starts with phc_).
POSTHOG_KEY=
# US cloud by default; EU projects use https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
